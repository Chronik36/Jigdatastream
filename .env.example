# Copy to .env and fill in. .env is git-ignored.

# Inboxes to sync, one after another: address:app password, separated by commas.
# App passwords: Google Account > Security > 2-Step Verification > App passwords.
GMAIL_ACCOUNTS=main@gmail.com:abcd efgh ijkl mnop, second@gmail.com:qrst uvwx yzab cdef

# Any OpenAI-compatible local server. Ollama default shown.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b

# Optional
# FIRST_SYNC_DAYS=365        # how far back an inbox's first sync reaches
# MAX_EMAILS=0               # cap per inbox per run, 0 = no cap
# GMAIL_QUERY=...            # Gmail search used to pick candidate mail (see jigstream/config.py)

# Optional live carrier tracking (https://www.ship24.com, "Tracking API and Webhook" per-shipment plan)
# SHIP24_API_KEY=
# TRACKING_REFRESH_HOURS=4
